# ── Database (MySQL via Prisma) ───────────────────────────────────────
# MySQL connection string. Prisma uses it for all data (users, pages, blogs, leads, media).
# connection_limit is PER SERVER INSTANCE. Locally 5 is fine; on Vercel use
# ?connection_limit=2 — every concurrent function instance opens its own pool,
# and shared MySQL (Hostinger) caps connections per user. The DB must also
# allow remote connections from any host (Vercel has no fixed IPs).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME?connection_limit=5"

# ── Auth ──────────────────────────────────────────────────────────────
# Secret used to sign admin login tokens (JWT). Any long random string.
# Generate one: openssl rand -hex 32
JWT_SECRET=

# ── Shared secret with Tech-Vedha-frontend ────────────────────────────
# Sent with cache-refresh calls to the website, and checked on enquiry forms
# the website posts here. Must be the same value as REVALIDATE_SECRET in
# Tech-Vedha-frontend's .env. Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# ── Email (Gmail SMTP): forgot-password codes + new-lead alerts ───────
# Gmail SMTP server
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS
SMTP_PORT=587
# false for port 587 (true only for port 465)
SMTP_SECURE=false
# Gmail address that sends the emails
SMTP_USER=
# 16-character Gmail App Password (NOT the normal password)
# Google Account → Security → 2-Step Verification → App passwords
SMTP_PASSWORD=
# Sender name + address shown in the inbox (use the same address as SMTP_USER)
SMTP_FROM="Tech Vedha CMS <same-gmail-address@gmail.com>"

# ── New-lead alerts ───────────────────────────────────────────────────
# Gets an email whenever a website form is submitted
ADMIN_NOTIFY_EMAIL=
# Optional: CC on those alerts (comma-separated for several)
# NOTIFY_CC_EMAIL=

# ── Media uploads (Hostinger FTP) ─────────────────────────────────────
# Images uploaded in the admin panel are sent here over FTP.
# FTP host / IP from Hostinger → Files → FTP Accounts (bare host, no ftp://)
HOSTINGER_FTP_HOST=
# FTP username
HOSTINGER_FTP_USER=
# FTP password
HOSTINGER_FTP_PASS=
# FTP port (normally 21)
HOSTINGER_FTP_PORT=21
# Encrypt the FTP connection (FTPS, explicit TLS). Default true. Set to false
# ONLY if the server has no TLS support: the FTP password and every file are
# then sent in clear text. There is no automatic fallback to plain FTP — if
# TLS cannot be started, uploads fail with an error in the server log.
HOSTINGER_FTP_SECURE=true
# A bare IP address in HOSTINGER_FTP_HOST works with full verification:
# Hostinger's FTP certificate is issued for "*.hstgr.io", so when the host is an
# IP the certificate is checked against this name instead. Change it only if
# the server presents a certificate for another name.
# HOSTINGER_FTP_TLS_HOSTNAME=hstgr.io
# LAST RESORT ONLY: true turns off ALL server verification (still encrypted,
# but anyone in the network path could pose as the server and capture the FTP
# password and uploaded CVs). It overrides the check above — keep it false.
HOSTINGER_FTP_TLS_INSECURE=false
# After deploying or changing either setting, upload a test image in the
# admin panel (Media) and delete it again to confirm FTPS works.
# This FTP account is shared with other projects: keep every Tech Vedha file
# under its own "tech-vedha" folder so nothing gets mixed. The folders are
# created automatically on the first upload.
# Public folder on the server where Media Library images are saved
HOSTINGER_MEDIA_PATH=/public_html/tech-vedha/media
# Public URL of that folder (used to build image links)
HOSTINGER_MEDIA_URL=https://your-domain.com/tech-vedha/media
# Private folder (NOT inside public_html) for CVs/letters sent with
# "Join our crew" applications
HOSTINGER_APPLICATIONS_PATH=/tech-vedha/applications

# ── Tech-Vedha-frontend (the public website) ──────────────────────────
# Where the website runs, no trailing slash. Locally http://localhost:3002;
# on Vercel the website's URL, e.g. https://<website project>.vercel.app
# Used server-side (after every save this app POSTs /api/revalidate there with
# REVALIDATE_SECRET) and for the editors' "View live" / "Preview" buttons.
FRONTEND_URL=http://localhost:3002
# Optional: both default to FRONTEND_URL (next.config.ts). Set them only to
# point somewhere different. NEXT_PUBLIC_ values are baked in at build time.
# NEXT_PUBLIC_FRONTEND_URL=
# PRODUCTION_URL=
